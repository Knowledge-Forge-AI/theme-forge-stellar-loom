              "type": "number",
              "minimum": 0,
              "maximum": 64
            },
            "border": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            "focus": {
              "type": "number",
              "minimum": 1,
              "maximum": 8
            },
            "content": {
              "type": "number",
              "minimum": 320,
              "maximum": 3840
            },
            "sidebar": {
              "type": "number",
              "minimum": 120,
              "maximum": 960
            },
            "borderStyle": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "focusOffset": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            }
          }
        },
        "layoutPreset": {
          "enum": [
            "standard",
            "compact",
            "wide"
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pageTitle"
          ],
          "properties": {
            "pageTitle": {
              "enum": [
                "consumer-default",
                "page-title-frame"
              ]
            }
          }
        },
        "codePresentation": {
          "const": "consumer-default"
        },
        "fonts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "family",
              "style",
              "weight",
              "format",
              "sha256",
              "license",
              "notice"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "family": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 -]{0,63}$"
              },
              "style": {
                "enum": [
                  "normal",
                  "italic",
                  "oblique"
                ]
              },
              "weight": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  },
                  {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{2}( [1-9][0-9]{2})?$"
                  }
                ]
              },
              "format": {
                "enum": [
                  "woff",
                  "woff2"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "license": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9.+-]{0,127}$"
              },
              "notice": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              }
            }
          }
        }
      }
    },
    "selectedAccent": {
      "$ref": "#/$defs/id"
    },
    "rationale": {
      "$ref": "#/$defs/text4096"
    },
    "visualSha": {
      "$ref": "#/$defs/digest"
    },
    "visualEvidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "schemaVersion",
          "presence",
          "evidenceDigest"
        ],
        "properties": {
          "schema": {
            "const": "tfsl.theme-visual-evidence"
          },
          "schemaVersion": {
            "enum": [
              1,
              2
            ]
          },
          "presence": {
            "enum": [
              "included",
              "absent",
              "unavailable"
            ]
          },
          "reason": {
            "type": "string"
          },
          "pngDigest": {
            "$ref": "#/$defs/digest"
          },
          "bytesBase64": {
            "type": "string"
          },
          "byteCount": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "enum": [
              "dark",
              "light"
            ]
          },
          "viewport": {
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "themeDigest": {
            "$ref": "#/$defs/digest"
          },
          "fixtureId": {
            "type": "string"
          },
          "evidenceDigest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "originV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetDigest",
        "byteDigest"
      ],
      "properties": {
        "packetDigest": {
          "$ref": "#/$defs/digest"
        },
        "byteDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "claimedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "$ref": "#/$defs/text256"
        },
        "toolName": {
          "$ref": "#/$defs/text256"
        },
        "toolVersion": {
          "$ref": "#/$defs/text128"
        },
        "timestamp": {
          "$ref": "#/$defs/text64"
        }
      }
    },
    "candidateDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
    },
    "text64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "text128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text4096": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
