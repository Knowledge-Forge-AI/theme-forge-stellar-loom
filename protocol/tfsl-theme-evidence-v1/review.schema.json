{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-forge.ai/tfsl/theme-evidence/v1/review.schema.json",
  "title": "TFSL theme review packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "reviewId",
    "briefDigest",
    "candidateDigests",
    "dispositions",
    "annotations",
    "overallDisposition",
    "summary",
    "reviewDigest"
  ],
  "properties": {
    "schema": { "const": "tfsl.theme-review" },
    "schemaVersion": { "const": 1 },
    "reviewId": { "$ref": "#/$defs/id" },
    "briefDigest": { "$ref": "#/$defs/digest" },
    "candidateDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/disposition" }
    },
    "annotations": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/annotation" }
    },
    "overallDisposition": { "$ref": "#/$defs/overall" },
    "summary": { "$ref": "#/$defs/text4096" },
    "reviewDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$" },
    "text64": { "type": "string", "minLength": 1, "maxLength": 64 },
    "text128": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text256": { "type": "string", "minLength": 1, "maxLength": 256 },
    "text512": { "type": "string", "minLength": 1, "maxLength": 512 },
    "text2048": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "text4096": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateDigest", "disposition"],
      "properties": {
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "disposition": {
          "enum": ["unreviewed", "preferred", "approved", "rejected", "needs-revision", "deferred"]
        },
        "comment": { "$ref": "#/$defs/text2048" }
      }
    },
    "overall": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["no-decision", "rejected-all"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "candidateDigest"],
          "properties": {
            "kind": { "enum": ["preferred", "approved", "needs-revision"] },
            "candidateDigest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotationId", "candidateDigest", "target", "category", "severity", "comment"],
      "properties": {
        "annotationId": { "$ref": "#/$defs/id" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "fieldPath"],
              "properties": {
                "kind": { "const": "field" },
                "fieldPath": { "$ref": "#/$defs/text128" },
                "mode": { "enum": ["dark", "light"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "evidenceDigest", "pngDigest", "region"],
              "properties": {
                "kind": { "const": "visual" },
                "evidenceDigest": { "$ref": "#/$defs/digest" },
                "pngDigest": { "$ref": "#/$defs/digest" },
                "region": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "integer", "minimum": 0, "maximum": 1000000 }
                }
              }
            }
          ]
        },
        "category": {
          "enum": ["contrast", "color", "typography", "layout", "brand-fit", "accessibility", "other"]
        },
        "severity": {
          "enum": ["note", "minor", "substantive", "blocking"]
        },
        "comment": { "$ref": "#/$defs/text2048" }
      }
    }
  }
}
