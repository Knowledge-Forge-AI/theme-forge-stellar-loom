  "defaultAccent": "blue",
  "typography": {
    "body": {
      "font": "system-serif",
      "size": 16,
      "lineHeight": 1.65
    },
    "heading": {
      "font": "system-serif",
      "size": 28,
      "lineHeight": 1.3
    },
    "ui": {
      "font": "system-sans",
      "size": 14,
      "lineHeight": 1.5
    },
    "code": {
      "font": "system-mono",
      "size": 14,
      "lineHeight": 1.5
    }
  },
  "surfaces": {
    "spacing": 4,
    "radii": 6,
    "border": 1,
    "focus": 2,
    "content": 1152,
    "sidebar": 288
  },
  "layoutPreset": "standard",
  "components": {
    "pageTitle": "consumer-default"
  },
  "codePresentation": {
    "mode": "expressive-code",
    "syntaxTheme": {
      "light": {
        "rules": [
          {
            "scopes": [
              "keyword"
            ],
            "foreground": "#84485b"
          },
          {
            "scopes": [
              "string"
            ],
            "foreground": "#326456"
          },
          {
            "scopes": [
              "comment"
            ],
            "foreground": "#676052"
          },
          {
            "scopes": [
              "entity.name.function"
            ],
            "foreground": "#425b86"
          },
          {
            "scopes": [
              "variable"
            ],
            "foreground": "#684780"
          },
          {
            "scopes": [
              "constant"
            ],
            "foreground": "#865723"
          }
        ]
      },
      "dark": {
        "rules": [
          {
            "scopes": [
              "keyword"
            ],
            "foreground": "#e6a4b8"
          },
          {
            "scopes": [
              "string"
            ],
            "foreground": "#9cd0b8"
          },
          {
            "scopes": [
              "comment"
            ],
            "foreground": "#b6b19e"
          },
          {
            "scopes": [
              "entity.name.function"
            ],
            "foreground": "#a8bdea"
          },
          {
            "scopes": [
              "variable"
            ],
            "foreground": "#cbb0e2"
          },
          {
            "scopes": [
              "constant"
            ],
            "foreground": "#e4c391"
          }
        ]
      }
    },
    "frame": "editor",
    "marks": {
      "marked": "#d4a329",
      "inserted": "#58a55c",
      "deleted": "#d95f5f"
    },
    "copy": "standard",
    "tabs": "deferred"
  },
  "fonts": [],
  "catalog": {
    "hero": {
      "routes": [
        {
          "route": "/catalog",
          "layout": "centered",
          "title": "Flexoki Documentation",
